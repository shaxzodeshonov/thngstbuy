{
  "expo": {
    "name": "thngstobuy",
    "slug": "thngstbuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "thngstbuy",
    "backgroundColor": "#FAF9F6",
    "splash": {
      "backgroundColor": "#FAF9F6",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.thngstbuy.client"
    },
    "android": {
      "package": "app.thngstbuy.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F6"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thngstbuy.vercel.app",
              "pathPrefix": "/l"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "f513685d-c326-4301-92bb-cd04a20d3bee"
      }
    },
    "owner": "shaxzodes-team"
  }
}
